# Copy this file to .env and fill in real values. Never commit .env.

# Application
ENVIRONMENT=development
DEBUG=false
DEFAULT_LANGUAGE=en

# Database (MySQL via PyMySQL driver)
DATABASE_URL=mysql+pymysql://scamshield:change-me@localhost:3306/scamshield?charset=utf8mb4
# Create tables on startup instead of running Alembic migrations (development only)
DATABASE_AUTO_CREATE=false

# Secret salt used to hash client identifiers (IP addresses, Telegram user IDs).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
HASH_SALT=change-me

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Requests allowed per client per minute on the analyze and feedback endpoints
RATE_LIMIT_PER_MINUTE=30
# Only enable behind a reverse proxy you control; otherwise clients can spoof X-Forwarded-For
TRUST_PROXY_HEADERS=false

# Verdict thresholds on the combined 0-1 risk score
SUSPICIOUS_THRESHOLD=0.35
SCAM_THRESHOLD=0.65
# How strongly each signal counts (0-1), and the score multiplier applied when
# every link in a message is official and no critical warning sign was found
VERDICT_RULE_WEIGHT=0.9
VERDICT_URL_WEIGHT=0.85
VERDICT_ML_WEIGHT=0.6
VERDICT_OFFICIAL_LINK_FACTOR=0.5

# Text classifier used by the API: baseline, muril (needs requirements-ml.txt),
# or none to rely on rules and links only
CLASSIFIER=baseline
# Device for MuRIL inference: cpu, cuda, mps or auto
MODEL_DEVICE=cpu

# URL analysis. Set URL_NETWORK_CHECKS=false to run only offline checks
# (no shortener expansion, WHOIS or reputation lookups).
URL_NETWORK_CHECKS=true
URL_REQUEST_TIMEOUT=5
URL_MAX_REDIRECTS=5
YOUNG_DOMAIN_DAYS=30

# Optional URL reputation services (leave blank to skip these checks)
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=

# Telegram bot
TELEGRAM_BOT_TOKEN=
API_BASE_URL=http://localhost:8000
# Shared secret the bot sends to the API so each Telegram user gets their own rate limit.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
BOT_API_KEY=
